{
  "name": "aqua-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-ts": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build": "vite build",
    "type-check": "vue-tsc --build",
    "quality": "run-s type-check lint test build",
    "test": "vitest run",
    "verify:production-build": "node scripts/verify-production-build.mjs",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint src",
    "lint:eslint": "eslint src --no-cache",
    "lint:fix": "run-s lint:fix:oxlint lint:fix:eslint",
    "lint:fix:oxlint": "oxlint src --fix",
    "lint:fix:eslint": "eslint src --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@mercadopago/sdk-js": "^0.0.3",
    "@tailwindcss/vite": "^4.2.4",
    "@turf/turf": "^7.3.5",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.15.2",
    "geojson": "^0.5.0",
    "hls.js": "^1.6.16",
    "mapbox-gl": "^3.22.0",
    "mercadopago": "^3.2.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/mapbox__mapbox-gl-geocoder": "^5.1.1",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
